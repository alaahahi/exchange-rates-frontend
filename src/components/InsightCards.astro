---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'ar' } = Astro.props;
const t = useTranslations(lang);

const cards = [
  { title: t('insightBuySellTitle'), body: t('insightBuySellBody') },
  { title: t('insightRemitTitle'), body: t('insightRemitBody') },
  { title: t('insightGoldTitle'), body: t('insightGoldBody') },
];
---

<section class="page-chrome grid gap-3 sm:grid-cols-3" aria-label="Tips">
  {
    cards.map((card) => (
      <article class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-card)] p-4 shadow-sm">
        <h2 class="m-0 text-sm font-bold text-[var(--color-ink)]">{card.title}</h2>
        <p class="m-0 mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{card.body}</p>
      </article>
    ))
  }
</section>
