---
import type { ExchangeRate } from '../lib/api/types';
import { formatInteger, formatPercentChange, formatDateTime } from '../lib/format';
import { changeDirection } from '../lib/appearance';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  rate: ExchangeRate;
  updatedAt?: string | null;
  lang?: Lang;
}

const { rate, updatedAt = rate.updated_at, lang = 'ar' } = Astro.props;
const t = useTranslations(lang);
const dir = changeDirection(rate.change);

function changeLabel(change: number | null): string {
  if (change === null || Number.isNaN(change) || change === 0) return t('noChange');
  return formatPercentChange(change);
}

const updatedLabel = updatedAt ? formatDateTime(updatedAt) : '';
---

<section class="usd-hero brand-panel" aria-labelledby="usd-hero-heading">
  <div class="usd-hero__veil" aria-hidden="true"></div>
  <div class="usd-hero__inner">
    <div class="usd-hero__headline">
      <span class="usd-hero__eyebrow">{t('heroEyebrow')}</span>
      <h1 id="usd-hero-heading" class="usd-hero__title">{t('heroTitle')}</h1>
      <p class="usd-hero__subtitle">{rate.name} — {t('heroSubtitle')}</p>
    </div>

    <div class="usd-hero__meta">
      <div class="usd-hero__change-wrap">
        <span class={`rate-change rate-change--${dir} usd-hero__change`} data-rate={rate.currency} data-field="change" data-change-dir={dir}>{changeLabel(rate.change)}</span>
      </div>
      {
        updatedLabel && (
          <p class="usd-hero__updated">
            {t('lastUpdate')} <time datetime={updatedAt ?? undefined} data-rate-updated>{updatedLabel}</time>
          </p>
        )
      }
    </div>

    <div class="usd-hero__rail" aria-hidden="true">
      <span></span>
      <span class="usd-hero__rail-dot"></span>
      <span></span>
    </div>

    <div class="usd-hero__prices">
      <article class="usd-hero__card">
        <p class="usd-hero__label">{t('buy')}</p>
        <p class="rate-buy usd-hero__value hero-price" data-rate={rate.currency} data-field="buy">{formatInteger(rate.buy)}</p>
        <p class="usd-hero__hint">{t('iqd')} · {t('perHundredUsd')}</p>
      </article>

      <article class="usd-hero__card usd-hero__card--featured">
        <p class="usd-hero__label usd-hero__label--accent">{t('sell')}</p>
        <p class="rate-sell usd-hero__value hero-price" data-rate={rate.currency} data-field="sell">{formatInteger(rate.sell)}</p>
        <p class="usd-hero__hint">{t('iqd')} · {t('perHundredUsd')}</p>
      </article>
    </div>

    <p class="usd-hero__spread">
      {t('spreadLabel')}
      <strong data-rate={rate.currency} data-field="spread">{formatInteger(Math.max(0, rate.sell - rate.buy))}</strong>
      {t('iqd')}
      <span>({t('perHundredUsd')})</span>
    </p>
  </div>
</section>

<style>
  .usd-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-gold) 26%, transparent);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--color-gold) 18%, transparent), transparent 38%),
      linear-gradient(180deg, color-mix(in srgb, var(--color-navy) 94%, white 1%) 0%, color-mix(in srgb, var(--color-navy-dark) 96%, black) 100%);
    color: white;
    box-shadow:
      0 18px 48px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .usd-hero__veil {
    pointer-events: none;
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.05) 50%, transparent 100%),
      radial-gradient(circle at 20% 100%, rgba(255, 255, 255, 0.08), transparent 34%),
      radial-gradient(circle at 80% 20%, color-mix(in srgb, var(--color-gold) 22%, transparent), transparent 34%);
    opacity: 0.85;
  }

  .usd-hero__inner {
    position: relative;
    padding: 1.5rem 1rem 1.25rem;
    text-align: center;
  }

  .usd-hero__headline {
    max-width: 40rem;
    margin: 0 auto;
  }

  .usd-hero__eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-gold-soft);
  }

  .usd-hero__title {
    margin: 0.55rem 0 0;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: 800;
    line-height: 1.05;
  }

  .usd-hero__subtitle {
    margin: 0.65rem 0 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .usd-hero__meta {
    margin-top: 1rem;
    display: grid;
    gap: 0.55rem;
    justify-items: center;
  }

  .usd-hero__change-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.35rem 0.55rem;
  }

  .usd-hero__change {
    font-size: 0.88rem;
  }

  .usd-hero__updated {
    margin: 0;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .usd-hero__rail {
    margin: 1rem auto 0;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    max-width: 18rem;
  }

  .usd-hero__rail span {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.22), transparent);
  }

  .usd-hero__rail-dot {
    flex: 0 0 auto;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-gold) 75%, white);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-gold) 18%, transparent);
  }

  .usd-hero__prices {
    margin-top: 1.15rem;
    display: grid;
    gap: 0.9rem;
  }

  .usd-hero__card {
    border-radius: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.03));
    padding: 1rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .usd-hero__card--featured {
    border-color: color-mix(in srgb, var(--color-gold) 42%, transparent);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-gold) 20%, transparent), color-mix(in srgb, var(--color-gold) 9%, transparent)),
      rgba(255, 255, 255, 0.03);
  }

  .usd-hero__label {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.66);
  }

  .usd-hero__label--accent {
    color: var(--color-gold-soft);
  }

  .usd-hero__value {
    margin: 0.7rem 0 0;
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .usd-hero__hint {
    margin: 0.5rem 0 0;
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.52);
  }

  .usd-hero__spread {
    margin: 1rem 0 0;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.68);
  }

  .usd-hero__spread strong {
    margin-inline: 0.28rem;
    color: var(--color-gold-soft);
  }

  .usd-hero__spread span {
    color: rgba(255, 255, 255, 0.44);
  }

  @media (min-width: 640px) {
    .usd-hero__inner {
      padding: 2rem 1.5rem 1.5rem;
    }
  }

  @media (min-width: 768px) {
    .usd-hero__prices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .usd-hero__card {
      padding: 1.2rem 1.35rem;
    }
  }
</style>
