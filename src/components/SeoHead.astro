---
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  ogImage?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonical = siteConfig.url,
  robots = siteConfig.robots,
  ogImage = siteConfig.ogImage,
} = Astro.props;

const absoluteOg = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, siteConfig.url).toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:locale" content="ar_IQ" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteOg} />

<meta name="twitter:card" content={siteConfig.twitterCard} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOg} />
