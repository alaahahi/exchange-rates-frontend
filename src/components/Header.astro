---
import { siteConfig } from '../config/site';
import type { Lang } from '../i18n/ui';
import { useTranslations, homePath } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import AppearancePanel from './AppearancePanel.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang?: Lang;
  showGold?: boolean;
  showCurrencies?: boolean;
}

const { lang = 'ar', showGold = true, showCurrencies = true } = Astro.props;
const t = useTranslations(lang);

const items = [
  { id: 'all', label: t('navHome') },
  { id: 'usd', label: t('navUsd') },
  { id: 'gold', label: t('navGold'), hidden: !showGold },
  { id: 'converter', label: t('navConverter') },
  { id: 'currencies', label: t('navCurrencies'), hidden: !showCurrencies },
].filter((item) => !('hidden' in item && item.hidden));
---

<header class="site-header sticky top-0 z-40 text-white">
  <div class="site-header__glow" aria-hidden="true"></div>
  <div class="site-header__frame mx-auto max-w-6xl px-3 py-3 sm:px-6 sm:py-4">
    <div class="site-header__top">
      <div class="site-header__tools">
        <LanguageSwitcher lang={lang} />
        <AppearancePanel lang={lang} />
        <ThemeToggle />
      </div>

      <a
        href={homePath(lang)}
        class="site-header__brand no-underline"
        aria-label={siteConfig.name}
        data-focus-reset
      >
        <span class="site-header__crest" aria-hidden="true"></span>
        <img
          src="/logo.png"
          alt={siteConfig.name}
          width="148"
          height="66"
          class="site-header__logo"
          decoding="async"
        />
        <span class="site-header__subtitle">{siteConfig.description}</span>
      </a>

      <div class="site-header__meta" aria-hidden="true">
        <span class="site-header__meta-line"></span>
        <span class="site-header__meta-text">Live Market Board</span>
        <span class="site-header__meta-line"></span>
      </div>
    </div>

    <nav class="site-header__nav" aria-label="Sections">
      <div class="section-nav ticker-scroll" role="tablist" id="section-nav">
        {
          items.map((item) => (
            <button
              type="button"
              class="section-nav-btn inline-flex min-h-11 shrink-0 items-center justify-center rounded-full px-4 text-[13px] font-semibold tracking-[0.12em] text-white/68 transition duration-200 hover:text-white sm:px-5 sm:text-sm"
              data-focus={item.id}
              role="tab"
              aria-selected={item.id === 'all' ? 'true' : 'false'}
            >
              {item.label}
            </button>
          ))
        }
      </div>
    </nav>
  </div>
  <div class="site-header__line" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    isolation: isolate;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-navy) 97%, transparent) 0%, color-mix(in srgb, var(--color-navy-dark) 96%, transparent) 100%);
    backdrop-filter: blur(18px) saturate(1.18);
    -webkit-backdrop-filter: blur(18px) saturate(1.18);
    box-shadow: 0 16px 42px rgba(0, 0, 0, 0.26);
  }

  .site-header__frame {
    position: relative;
  }

  .site-header__top {
    position: relative;
    display: grid;
    gap: 1rem;
    align-items: center;
    justify-items: center;
  }

  .site-header__brand {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    text-align: center;
    color: inherit;
  }

  .site-header__crest {
    width: 5.5rem;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--color-gold) 75%, white) 50%, transparent 100%);
    opacity: 0.9;
  }

  .site-header__logo {
    height: 4rem;
    width: auto;
    border-radius: 1rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.92));
    padding: 0.4rem 0.55rem;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.16),
      0 12px 36px rgba(0, 0, 0, 0.2);
  }

  .site-header__subtitle,
  .site-header__meta-text {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-gold) 70%, white);
  }

  .site-header__meta {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header__meta-line {
    width: 2.75rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
  }

  .site-header__nav {
    margin-top: 1rem;
    display: flex;
    justify-content: center;
  }

  .section-nav {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    overflow-x: auto;
    border-radius: 999px;
    border: 1px solid rgba(194, 153, 83, 0.24);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.03)),
      rgba(8, 16, 34, 0.78);
    padding: 0.45rem;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 10px 26px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(10px);
  }

  .site-header__glow {
    pointer-events: none;
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 120% at 100% 0%, color-mix(in srgb, var(--color-gold) 18%, transparent), transparent 55%),
      radial-gradient(ellipse 40% 100% at 0% 100%, rgba(255, 255, 255, 0.06), transparent 50%);
    z-index: -1;
  }

  .site-header__line {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--color-gold) 55%, transparent) 28%,
      rgba(255, 255, 255, 0.2) 50%,
      color-mix(in srgb, var(--color-gold) 55%, transparent) 72%,
      transparent 100%
    );
  }

  .section-nav-btn.is-active {
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-gold) 75%, white) 0%, var(--color-gold) 100%);
    color: var(--color-navy);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.34) inset,
      0 8px 18px color-mix(in srgb, var(--color-gold) 32%, transparent);
  }

  .site-header__tools :global(.lang-trigger),
  .site-header__tools :global(#appearance-toggle),
  .site-header__tools :global(#theme-toggle) {
    height: 2.5rem;
    min-width: 2.5rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.88);
  }

  .site-header__tools :global(.lang-trigger:hover),
  .site-header__tools :global(#appearance-toggle:hover),
  .site-header__tools :global(#theme-toggle:hover) {
    background: rgba(255, 255, 255, 0.11);
    color: #f0d9a6;
  }

  .site-header__tools {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.045);
    padding: 0.35rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .site-header__tools :global(.lang-trigger) {
    padding-inline: 0.8rem;
  }

  @media (min-width: 900px) {
    .site-header__top {
      grid-template-columns: 1fr auto 1fr;
    }

    .site-header__tools {
      justify-self: start;
    }

    .site-header__meta {
      display: inline-flex;
      justify-self: end;
    }

    [dir='rtl'] .site-header__tools {
      justify-self: end;
    }

    [dir='rtl'] .site-header__meta {
      justify-self: start;
    }
  }

  @media (max-width: 639px) {
    .site-header__logo {
      height: 3.45rem;
    }

    .site-header__subtitle {
      letter-spacing: 0.18em;
      font-size: 0.62rem;
    }

    .section-nav {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-nav-btn {
      transition: none;
    }
  }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.section-nav-btn'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const shell = document.getElementById('page-shell');
  const resetLinks = Array.from(document.querySelectorAll('[data-focus-reset]'));

  function setFocus(focusId: string): void {
    const showAll = focusId === 'all';
    document.body.classList.toggle('section-focus-mode', !showAll);
    shell?.classList.toggle('is-focusing', !showAll);
    shell?.setAttribute('data-active-panel', showAll ? 'all' : focusId);

    panels.forEach((panel) => {
      const id = panel.dataset.panel;
      const match = showAll || id === focusId;
      panel.hidden = !match;
      panel.classList.toggle('is-expanded', !showAll && match);
    });

    buttons.forEach((button) => {
      const active = button.dataset.focus === focusId;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-selected', active ? 'true' : 'false');
    });

    if (!showAll) {
      document.querySelector<HTMLElement>(`[data-panel="${focusId}"]`)?.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    } else {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => setFocus(button.dataset.focus || 'all'));
  });

  resetLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      if (document.body.classList.contains('section-focus-mode')) {
        event.preventDefault();
        setFocus('all');
      }
    });
  });

  setFocus('all');
</script>
