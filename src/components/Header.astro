---
import { siteConfig } from '../config/site';
---

<header class="border-b border-[var(--color-line)] bg-white/90 backdrop-blur-sm">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-3 no-underline" aria-label={siteConfig.name}>
      <img
        src="/logo.png"
        alt={siteConfig.name}
        width="160"
        height="72"
        class="h-12 w-auto sm:h-14"
        decoding="async"
      />
    </a>
    <p class="hidden text-sm font-medium text-[var(--color-muted)] sm:block">
      {siteConfig.tagline}
    </p>
  </div>
</header>
