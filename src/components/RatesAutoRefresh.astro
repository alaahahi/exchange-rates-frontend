---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  /** Optional absolute API base. Defaults to same-origin proxy (avoids CORS). */
  apiUrl?: string;
  intervalMs?: number;
  lang?: Lang;
}

const apiUrl = (Astro.props.apiUrl ?? '/api').replace(/\/$/, '');
const intervalMs = Astro.props.intervalMs ?? 30000;
const lang = Astro.props.lang ?? 'ar';
const t = useTranslations(lang);
const secondsTotal = Math.max(1, Math.round(intervalMs / 1000));
---

<div
  id="rates-auto-refresh"
  class="hidden"
  data-api-url={apiUrl}
  data-interval={String(intervalMs)}
  aria-hidden="true"
></div>

<div
  id="rates-refresh-bar"
  class="rates-refresh-bar"
  role="status"
  aria-live="polite"
  data-seconds-total={String(secondsTotal)}
  data-waiting={t('autoRefreshWaiting')}
  data-updating={t('autoRefreshUpdating')}
>
  <div class="rates-refresh-bar__inner">
    <span class="rates-refresh-bar__dot" aria-hidden="true"></span>
    <span class="rates-refresh-bar__label">{t('autoRefreshLabel')}</span>
    <strong id="rates-countdown" class="rates-refresh-bar__count">{secondsTotal}</strong>
    <span class="rates-refresh-bar__unit">{t('autoRefreshSeconds')}</span>
    <span class="rates-refresh-bar__sep" aria-hidden="true">·</span>
    <span id="rates-refresh-status" class="rates-refresh-bar__status">{t('autoRefreshWaiting')}</span>
  </div>
  <div class="rates-refresh-bar__track" aria-hidden="true">
    <div id="rates-countdown-progress" class="rates-refresh-bar__progress" style="width:100%"></div>
  </div>
</div>

<style>
  .rates-refresh-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-navy) 94%, transparent);
    color: #fff;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 45%, transparent);
    box-shadow: 0 -8px 28px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .rates-refresh-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .rates-refresh-bar__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-gold);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-gold) 25%, transparent);
    animation: rates-pulse 1.4s ease-in-out infinite;
  }

  .rates-refresh-bar__label {
    color: rgba(255, 255, 255, 0.78);
  }

  .rates-refresh-bar__count {
    min-width: 1.6rem;
    text-align: center;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-gold-soft, #e8d4a8);
  }

  .rates-refresh-bar__unit,
  .rates-refresh-bar__sep,
  .rates-refresh-bar__status {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
  }

  .rates-refresh-bar__track {
    height: 3px;
    background: rgba(255, 255, 255, 0.12);
  }

  .rates-refresh-bar__progress {
    height: 100%;
    background: linear-gradient(90deg, var(--color-gold), color-mix(in srgb, var(--color-gold) 55%, white));
    transition: width 0.9s linear;
  }

  .rates-refresh-bar.is-updating .rates-refresh-bar__status {
    color: var(--color-gold-soft, #e8d4a8);
  }

  @keyframes rates-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(0.85);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rates-refresh-bar__dot {
      animation: none;
    }
    .rates-refresh-bar__progress {
      transition: none;
    }
  }
</style>

<script>
  type RateRow = {
    currency: string;
    name: string;
    buy: number;
    sell: number;
    quote_unit?: number;
    change: number | null;
    updated_at?: string | null;
  };

  const root = document.getElementById('rates-auto-refresh');
  const bar = document.getElementById('rates-refresh-bar');
  const countdownEl = document.getElementById('rates-countdown');
  const progressEl = document.getElementById('rates-countdown-progress');
  const statusEl = document.getElementById('rates-refresh-status');

  if (root && bar && countdownEl && progressEl) {
    const apiUrl = root.dataset.apiUrl || '/api';
    const intervalMs = Number(root.dataset.interval || '30000');
    const secondsTotal = Math.max(1, Number(bar.dataset.secondsTotal || Math.round(intervalMs / 1000)));
    const waitingText = bar.dataset.waiting || '';
    const updatingText = bar.dataset.updating || '…';
    let secondsLeft = secondsTotal;
    let tickTimer: number | null = null;
    let inFlight = false;

    const numberFmt = new Intl.NumberFormat('en-US', { useGrouping: false, maximumFractionDigits: 4 });
    const intFmt = new Intl.NumberFormat('en-US', { useGrouping: false, maximumFractionDigits: 0 });

    function formatValue(value: number | null, field: string): string {
      if (field === 'change') {
        if (value === null || Number.isNaN(value)) return '—';
        const sign = value > 0 ? '+' : '';
        return `${sign}${numberFmt.format(Number(value.toFixed(2)))}%`;
      }
      const num = Number(value ?? 0);
      if (Math.abs(num) >= 100 || Number.isInteger(num)) return intFmt.format(num);
      return numberFmt.format(num);
    }

    function setText(selector: string, value: string): void {
      document.querySelectorAll(selector).forEach((el) => {
        el.textContent = value;
      });
    }

    function renderCountdown(): void {
      countdownEl.textContent = String(secondsLeft);
      const pct = (secondsLeft / secondsTotal) * 100;
      progressEl.style.width = `${Math.max(0, Math.min(100, pct))}%`;
    }

    function applyRates(rates: RateRow[]): void {
      const byCode = new Map(rates.map((rate) => [rate.currency, rate]));

      document.querySelectorAll<HTMLElement>('[data-rate][data-field]').forEach((el) => {
        const code = el.dataset.rate;
        const field = el.dataset.field;
        if (!code || !field) return;
        const rate = byCode.get(code);
        if (!rate) return;

        if (field === 'buy') el.textContent = formatValue(rate.buy, field);
        if (field === 'sell') el.textContent = formatValue(rate.sell, field);
        if (field === 'change') {
          el.textContent = formatValue(rate.change, field);
          const dir =
            rate.change === null || Number.isNaN(rate.change) || rate.change === 0
              ? 'flat'
              : rate.change > 0
                ? 'up'
                : 'down';
          el.dataset.changeDir = dir;
          el.classList.remove('rate-change--up', 'rate-change--down', 'rate-change--flat');
          if (el.classList.contains('rate-change')) {
            el.classList.add(`rate-change--${dir}`);
          }
        }
        if (field === 'spread') el.textContent = formatValue(Math.max(0, rate.sell - rate.buy), 'buy');
      });

      const usd = byCode.get('USD');
      if (usd) {
        const quoteUnit = usd.quote_unit && usd.quote_unit > 0 ? usd.quote_unit : 100;
        const sellPerUnit = usd.sell / quoteUnit;
        document.querySelectorAll<HTMLElement>('[data-usd-preset]').forEach((el) => {
          const amount = Number(el.dataset.usdPreset || '0');
          if (!Number.isFinite(amount)) return;
          el.textContent = intFmt.format(amount * sellPerUnit);
        });
      }

      const converter = document.getElementById('converter');
      if (converter) {
        const existing: RateRow[] = JSON.parse(converter.getAttribute('data-rates') || '[]');
        const iqd = existing.find((row) => row.currency === 'IQD') ?? {
          currency: 'IQD',
          name: 'IQD',
          buy: 1,
          sell: 1,
          quote_unit: 1,
          change: 0,
        };
        const next = [
          ...rates.map((rate) => ({
            currency: rate.currency,
            name: rate.name,
            buy: rate.buy,
            sell: rate.sell,
            quote_unit: rate.quote_unit ?? 100,
            change: rate.change,
          })),
          iqd,
        ];
        converter.setAttribute('data-rates', JSON.stringify(next));
        window.dispatchEvent(new CustomEvent('rates:updated', { detail: { rates: next } }));
        const fromAmount = document.getElementById('from-amount');
        fromAmount?.dispatchEvent(new Event('input', { bubbles: true }));
      }

      const updatedAt = rates.find((rate) => rate.updated_at)?.updated_at;
      if (updatedAt) {
        const label = new Intl.DateTimeFormat('en-GB', {
          dateStyle: 'medium',
          timeStyle: 'short',
          timeZone: 'Asia/Baghdad',
          numberingSystem: 'latn',
        }).format(new Date(updatedAt));
        setText('[data-rate-updated]', label);
      }
    }

    async function poll(): Promise<void> {
      if (!apiUrl || inFlight) return;
      if (document.visibilityState !== 'visible') return;

      inFlight = true;
      bar.classList.add('is-updating');
      if (statusEl) statusEl.textContent = updatingText;

      try {
        const response = await fetch(`${apiUrl}/exchange-rates`, {
          headers: { Accept: 'application/json' },
          cache: 'no-store',
        });
        const body = await response.json();
        if (!response.ok || !body?.success || !Array.isArray(body.data)) {
          throw new Error('bad response');
        }
        applyRates(body.data as RateRow[]);
      } catch (error) {
        console.warn('[rates-auto-refresh] poll failed', error);
      } finally {
        inFlight = false;
        bar.classList.remove('is-updating');
        if (statusEl) statusEl.textContent = waitingText;
        secondsLeft = secondsTotal;
        renderCountdown();
      }
    }

    function tick(): void {
      if (document.visibilityState !== 'visible') return;
      if (inFlight) return;

      secondsLeft -= 1;
      if (secondsLeft <= 0) {
        secondsLeft = 0;
        renderCountdown();
        void poll();
        return;
      }
      renderCountdown();
    }

    function start(): void {
      if (tickTimer !== null) window.clearInterval(tickTimer);
      secondsLeft = secondsTotal;
      renderCountdown();
      void poll();
      tickTimer = window.setInterval(tick, 1000);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        secondsLeft = secondsTotal;
        renderCountdown();
        void poll();
      }
    });

    start();
  }
</script>
