---
import { formatDecimal } from '../lib/format';
import type { Lang, UiKey } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'ar' } = Astro.props;
const t = useTranslations(lang);

type CityWeather = {
  id: string;
  nameKey: UiKey;
  temperature: number;
  label: string;
};

const cities = [
  { id: 'baghdad', nameKey: 'weatherBaghdad' as const, lat: 33.3152, lon: 44.3661 },
  { id: 'basra', nameKey: 'weatherBasra' as const, lat: 30.5085, lon: 47.7804 },
  { id: 'erbil', nameKey: 'weatherErbil' as const, lat: 36.1911, lon: 44.0094 },
  { id: 'sulaymaniyah', nameKey: 'weatherSulaymaniyah' as const, lat: 35.561, lon: 45.4336 },
  { id: 'karbala', nameKey: 'weatherKarbala' as const, lat: 32.6163, lon: 44.0249 },
];

function weatherLabel(code: number, currentLang: Lang): string {
  const en = currentLang === 'en';
  if (code === 0) return en ? 'Clear' : 'صافي';
  if ([1, 2, 3].includes(code)) return en ? 'Partly cloudy' : 'غائم جزئياً';
  if ([45, 48].includes(code)) return en ? 'Fog' : 'ضباب';
  if ([51, 53, 55, 61, 63, 65, 80, 81, 82].includes(code)) return en ? 'Rain' : 'ممطر';
  if ([71, 73, 75, 77, 85, 86].includes(code)) return en ? 'Snow' : 'ثلج';
  if ([95, 96, 99].includes(code)) return en ? 'Storms' : 'عواصف';
  return en ? 'Variable' : 'متقلب';
}

async function fetchCityWeather(
  city: (typeof cities)[number],
  currentLang: Lang,
): Promise<CityWeather | null> {
  try {
    const url = `https://api.open-meteo.com/v1/forecast?latitude=${city.lat}&longitude=${city.lon}&current=temperature_2m,weather_code&timezone=Asia%2FBaghdad`;
    const response = await fetch(url, { headers: { Accept: 'application/json' } });
    if (!response.ok) return null;

    const data = await response.json();
    const code = Number(data?.current?.weather_code ?? -1);
    const temp = Number(data?.current?.temperature_2m);
    if (!Number.isFinite(temp)) return null;

    return {
      id: city.id,
      nameKey: city.nameKey,
      temperature: temp,
      label: weatherLabel(code, currentLang),
    };
  } catch {
    return null;
  }
}

const results = await Promise.all(cities.map((city) => fetchCityWeather(city, lang)));
const weatherList = results.filter((item): item is CityWeather => item !== null);
---

{
  weatherList.length > 0 && (
    <aside class="h-full rounded-2xl border border-[var(--color-line)] bg-[linear-gradient(135deg,#0d2149,#1a3568)] p-4 text-white shadow-sm">
      <p class="m-0 text-xs font-semibold text-[var(--color-gold-soft)]">{t('weatherTitle')}</p>
      <ul class="m-0 mt-3 grid list-none gap-2 p-0">
        {weatherList.map((city) => (
          <li class="flex items-center justify-between gap-3 rounded-xl bg-white/5 px-3 py-2">
            <div class="min-w-0">
              <p class="m-0 text-sm font-bold">{t(city.nameKey)}</p>
              <p class="m-0 text-xs text-white/65">{city.label}</p>
            </div>
            <p class="m-0 text-lg font-bold tabular-nums text-[var(--color-gold-soft)]">
              {formatDecimal(city.temperature, 1)}°
            </p>
          </li>
        ))}
      </ul>
    </aside>
  )
}
