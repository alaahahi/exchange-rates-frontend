---
import { ADSENSE_CLIENT } from '../config/adsense';

/**
 * Display ad unit (optional manual slots). Auto ads work via GoogleAdSense alone.
 */
interface Props {
  enabled?: boolean;
  slot?: string;
  format?: 'auto' | 'rectangle' | 'horizontal';
  label?: string;
}

const client = ADSENSE_CLIENT;
const slot = (Astro.props.slot || '').trim();
const enabled = (Astro.props.enabled ?? true) && Boolean(slot);
const format = Astro.props.format ?? 'auto';
const label = Astro.props.label ?? 'إعلان';
---

{
  enabled && (
    <aside class="ad-slot page-chrome" aria-label={label}>
      <div class="ad-slot__inner">
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={client}
          data-ad-slot={slot}
          data-ad-format={format}
          data-full-width-responsive="true"
        />
      </div>
    </aside>
  )
}

{
  enabled && (
    <script is:inline>
      (function () {
        function pushAd() {
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (e) {}
        }
        if (document.readyState === 'complete') {
          setTimeout(pushAd, 800);
        } else {
          window.addEventListener('load', function () {
            setTimeout(pushAd, 800);
          });
        }
      })();
    </script>
  )
}

<style>
  .ad-slot {
    margin: 0;
  }

  .ad-slot__inner {
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 0.85rem;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-card) 92%, var(--color-navy) 8%);
  }

  .ad-slot__inner :global(ins.adsbygoogle) {
    width: 100%;
    min-height: 90px;
  }
</style>
