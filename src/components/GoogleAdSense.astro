---
/**
 * AdSense — main dinar-now site only (hardcoded for static deploy).
 */
interface Props {
  enabled?: boolean;
}

const enabled = Astro.props.enabled ?? true;
---

{
  enabled && (
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2056125588674533"
      crossorigin="anonymous"
    />
  )
}
