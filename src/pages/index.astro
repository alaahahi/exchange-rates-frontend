---
import Layout from '../layouts/Layout.astro';
import ExchangeRatesTable from '../components/ExchangeRatesTable.astro';
import LastUpdated from '../components/LastUpdated.astro';
import RefreshButton from '../components/RefreshButton.astro';
import StatusMessage from '../components/StatusMessage.astro';
import { siteConfig } from '../config/site';
import { getExchangeRates } from '../lib/api/exchangeRates';
import { ApiError } from '../lib/api/errors';
import type { ExchangeRate } from '../lib/api/types';

let rates: ExchangeRate[] = [];
let errorMessage: string | null = null;

try {
  rates = await getExchangeRates({
    headers: {
      'Cache-Control': 'no-cache',
    },
  });
} catch (error) {
  errorMessage =
    error instanceof ApiError
      ? error.message
      : 'تعذر تحميل أسعار الصرف حالياً، يرجى المحاولة مرة أخرى.';
}

const latestUpdate =
  rates
    .map((rate) => rate.updated_at)
    .filter((value): value is string => Boolean(value))
    .sort()
    .at(-1) ?? null;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.name,
    url: siteConfig.url,
    description: siteConfig.description,
    inLanguage: 'ar',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.url,
  },
];
---

<Layout
  title={siteConfig.title}
  description={siteConfig.description}
  canonical={siteConfig.url}
  jsonLd={jsonLd}
>
  <section class="mb-8">
    <h1 class="m-0 text-3xl font-bold tracking-tight text-[var(--color-ink)] sm:text-4xl">
      {siteConfig.title}
    </h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-[var(--color-muted)] sm:text-lg">
      {siteConfig.description}
    </p>
  </section>

  <section aria-labelledby="rates-heading" class="space-y-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 id="rates-heading" class="m-0 text-xl font-semibold">جدول الأسعار</h2>
        <LastUpdated updatedAt={latestUpdate} />
      </div>
      <RefreshButton />
    </div>

    {
      errorMessage ? (
        <StatusMessage type="error" message={errorMessage} />
      ) : rates.length === 0 ? (
        <StatusMessage type="empty" message="لا توجد أسعار صرف متاحة حالياً." />
      ) : (
        <ExchangeRatesTable rates={rates} />
      )
    }
  </section>
</Layout>
